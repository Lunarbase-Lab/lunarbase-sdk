{
  "name": "@lunarbase/client-base",
  "version": "0.2.0",
  "description": "Base Flashblocks client for LunarBase",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lunarbase-Lab/lunarbase-sdk.git",
    "directory": "packages/client-base"
  },
  "type": "module",
  "files": ["dist", "!dist/**/*.test.*"],
  "publishConfig": {"access": "public"},
  "dependencies": {
    "@lunarbase/client-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && tsc -p tsconfig.json"
  }
}
