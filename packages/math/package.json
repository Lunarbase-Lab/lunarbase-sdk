{
  "name": "@lunarbase-lab/pmm-v2-math",
  "version": "0.3.0",
  "description": "Bit-exact LunarBase quote math for TypeScript",
  "keywords": [
    "lunarbase",
    "pmm",
    "defi",
    "evm",
    "quote-math"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lunarbase-Lab/lunarbase-sdk.git",
    "directory": "packages/math"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ox": "0.14.30"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "node --input-type=module --eval \"import { access } from 'node:fs/promises'; await Promise.all(['dist/index.js', 'dist/index.d.ts'].map((file) => access(file)))\""
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false
}
