{
  "name": "@lunarbase/source-evm",
  "version": "0.3.0",
  "description": "Generic EVM RPC and WebSocket data source for LunarBase",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lunarbase-Lab/lunarbase-sdk.git",
    "directory": "packages/source-evm"
  },
  "type": "module",
  "files": ["dist", "!dist/**/*.test.*"],
  "publishConfig": {"access": "public"},
  "dependencies": {
    "@lunarbase/client": "workspace:*",
    "@lunarbase/math": "workspace:*",
    "ox": "0.14.30",
    "viem": "2.55.2"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && tsc -p tsconfig.json"
  }
}
