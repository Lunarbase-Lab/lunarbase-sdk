{
  "name": "@lunarbase-lab/pmm-v2-source-evm",
  "version": "0.4.1",
  "description": "Generic EVM RPC and WebSocket data source for LunarBase",
  "keywords": [
    "lunarbase",
    "evm",
    "base",
    "rpc",
    "websocket"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lunarbase-Lab/lunarbase-sdk.git",
    "directory": "packages/source-evm"
  },
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@lunarbase-lab/pmm-v2-client": "workspace:*",
    "@lunarbase-lab/pmm-v2-math": "workspace:*",
    "ox": "0.14.30",
    "viem": "2.55.11"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "node --input-type=module --eval \"import { access } from 'node:fs/promises'; await Promise.all(['dist/index.js', 'dist/index.d.ts'].map((file) => access(file)))\""
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false
}
