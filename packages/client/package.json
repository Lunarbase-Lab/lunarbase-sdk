{
  "name": "@lunarbase/client",
  "version": "0.1.0",
  "description": "Compatibility facade for all LunarBase TypeScript clients",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "files": ["dist", "!dist/**/*.test.*"],
  "publishConfig": {"access": "public"},
  "dependencies": {
    "@lunarbase/client-arbitrum": "workspace:*",
    "@lunarbase/client-base": "workspace:*",
    "@lunarbase/client-core": "workspace:*",
    "@lunarbase/client-monad": "workspace:*",
    "@lunarbase/math": "workspace:*"
  },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && tsc -p tsconfig.json"
  }
}
