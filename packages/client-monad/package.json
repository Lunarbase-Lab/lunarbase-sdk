{
  "name": "@lunarbase/client-monad",
  "version": "0.1.0",
  "description": "Monad execution-events client for LunarBase",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "files": ["dist", "!dist/**/*.test.*"],
  "publishConfig": {"access": "public"},
  "dependencies": {
    "@lunarbase/client-core": "workspace:*",
    "@lunarbase/math": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && tsc -p tsconfig.json"
  }
}
