{
  "name": "@lunarbase/client-arbitrum",
  "version": "0.2.0",
  "description": "Experimental Arbitrum Nitro client for LunarBase",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lunarbase-Lab/lunarbase-sdk.git",
    "directory": "packages/client-arbitrum"
  },
  "type": "module",
  "files": ["dist", "!dist/**/*.test.*"],
  "publishConfig": {"access": "public"},
  "dependencies": {
    "@lunarbase/client-core": "workspace:*",
    "@lunarbase/math": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs dist && tsc -p tsconfig.json"
  }
}
