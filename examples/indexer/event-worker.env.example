# Dedicated event source identity.
LUNARBASE_EVENT_NETWORK=base
LUNARBASE_EVENT_CHAIN_ID=8453
LUNARBASE_EVENT_CORE=
LUNARBASE_EVENT_DEPLOYMENT_BLOCK=
LUNARBASE_EVENT_HTTP_RPC_URL=http://host.docker.internal:8545
LUNARBASE_EVENT_REALTIME_URL=ws://host.docker.internal:8546

# Durable Redis Stream. The server must use appendonly=yes,
# appendfsync=always, and maxmemory-policy=noeviction.
LUNARBASE_EVENT_REDIS_URL=redis://127.0.0.1:6379
LUNARBASE_EVENT_REDIS_NAMESPACE=lunarbase
LUNARBASE_EVENT_CONSUMER_GROUP=lunarbase-processors

# Delivery and independent resource limits.
LUNARBASE_EVENT_MIN_COMMITMENT=realtime
LUNARBASE_EVENT_BIND=127.0.0.1:9091
LUNARBASE_EVENT_SOURCE_QUEUE_BOUND=4096
LUNARBASE_EVENT_REDIS_QUEUE_BOUND=8
LUNARBASE_EVENT_RECONNECT_DELAY_MILLISECONDS=1000
LUNARBASE_EVENT_SOURCE_STALL_TIMEOUT_MILLISECONDS=30000
LUNARBASE_EVENT_REDIS_TIMEOUT_MILLISECONDS=2000
LUNARBASE_EVENT_SHUTDOWN_TIMEOUT_SECONDS=10
