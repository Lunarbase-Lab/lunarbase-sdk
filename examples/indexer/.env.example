# Required deployment identity.
LUNARBASE_CORE=
LUNARBASE_FEE_CLASS=whitelisted
LUNARBASE_DEPLOYMENT_BLOCK=
LUNARBASE_EXPECTED_IMPLEMENTATION=
LUNARBASE_EXPECTED_IMPLEMENTATION_CODE_HASH=

# Optional exact-router fee allocation. Omit for the fastest class-only mode.
# LUNARBASE_VERIFIED_ROUTER=0x0000000000000000000000000000000000000002

# Source values.
LUNARBASE_HTTP_RPC_URL=http://host.docker.internal:8545
LUNARBASE_REALTIME_URL=ws://host.docker.internal:8546
LUNARBASE_DELIVERY_MODE=realtime

# Independent event-worker connections and delivery policy.
LUNARBASE_EVENT_HTTP_RPC_URL=http://host.docker.internal:8545
LUNARBASE_EVENT_REALTIME_URL=ws://host.docker.internal:8546
LUNARBASE_EVENT_MIN_COMMITMENT=realtime
