# Required.
RPC_URL=https://mainnet.base.org
CORE_ADDRESS=0x0000000000000000000000000000000000000001
SOURCE_PROFILE=base-flashblocks

# Optional. If omitted, the WebSocket URL is derived from RPC_URL.
# WS_URL=wss://mainnet.base.org

# Set the real integration router to reproduce its exact fee profile.
# Without it, the example uses a non-whitelisted demonstration address.
# ROUTER_ADDRESS=0x0000000000000000000000000000000000000002
EXPECT_WHITELISTED=false

# Optional runtime tuning.
# DEPLOYMENT_BLOCK=0
# LANE_ASSETS=0x0000000000000000000000000000000000000003
# QUOTE_AMOUNT=1000000000000000000
# QUOTE_INTERVAL_SECONDS=2
