{
  "name": "@lunarbase/example-quote-logger",
  "private": true,
  "version": "0.2.0",
  "description": "Runnable realtime quote logger built on the LunarBase TypeScript client",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "node ../../../scripts/clean-dist.mjs dist && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@lunarbase/client-base": "workspace:*",
    "@lunarbase/client-core": "workspace:*",
    "@lunarbase/math": "workspace:*",
    "ox": "0.14.30",
    "zod": "4.3.6"
  }
}
