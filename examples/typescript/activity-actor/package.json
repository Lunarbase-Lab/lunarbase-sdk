{
  "name": "@lunarbase-lab/example-activity-actor",
  "private": true,
  "version": "0.3.0",
  "description": "Fail-closed BSC Testnet activity actor for a LunarBase Core deployment",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "node ../../../scripts/clean-dist.mjs dist && tsc -p tsconfig.json",
    "wallet:new": "node dist/generate-wallet.js",
    "inspect": "node --env-file-if-exists=.env dist/main.js --inspect",
    "once": "node --env-file-if-exists=.env dist/main.js --once",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "node --test dist/*.test.js"
  },
  "dependencies": {
    "@lunarbase-lab/pmm-v2-math": "workspace:*",
    "viem": "2.55.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3"
  }
}
