{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunarbase.dev/schemas/quote-state/v3",
  "title": "LunarBase indexer checkpoint v3",
  "type": "object",
  "required": [
    "schemaVersion",
    "mathCompatibilityVersion",
    "expectedRuntimeCodeHash",
    "chainId",
    "core",
    "router",
    "cursor",
    "state"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "mathCompatibilityVersion": { "type": "string", "minLength": 1 },
    "expectedRuntimeCodeHash": { "$ref": "#/$defs/hex32" },
    "chainId": { "$ref": "#/$defs/u64" },
    "core": { "$ref": "#/$defs/hex20" },
    "router": { "$ref": "#/$defs/hex20" },
    "cursor": { "$ref": "#/$defs/cursor" },
    "state": { "$ref": "#/$defs/state" }
  },
  "$defs": {
    "u8": { "type": "integer", "minimum": 0, "maximum": 255 },
    "u32": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "u64": { "type": "integer", "minimum": 0 },
    "u128": { "type": "integer", "minimum": 0 },
    "u256": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "hex20": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "hex32": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "cursor": {
      "type": "object",
      "required": [
        "chainId",
        "blockNumber",
        "executionBlockNumber",
        "blockHash",
        "transactionIndex",
        "logIndex",
        "sourceSequence",
        "sourceSubIndex",
        "commitment"
      ],
      "properties": {
        "chainId": { "$ref": "#/$defs/u64" },
        "blockNumber": { "$ref": "#/$defs/u64" },
        "executionBlockNumber": { "$ref": "#/$defs/u64" },
        "blockHash": { "oneOf": [{ "$ref": "#/$defs/hex32" }, { "type": "null" }] },
        "transactionIndex": { "oneOf": [{ "$ref": "#/$defs/u32" }, { "type": "null" }] },
        "logIndex": { "oneOf": [{ "$ref": "#/$defs/u32" }, { "type": "null" }] },
        "sourceSequence": { "oneOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "sourceSubIndex": { "oneOf": [{ "$ref": "#/$defs/u32" }, { "type": "null" }] },
        "commitment": { "enum": ["realtime", "canonical", "finalized"] }
      },
      "additionalProperties": false
    },
    "lane": {
      "type": "object",
      "required": [
        "asset",
        "slot0",
        "totalPrincipalAmount",
        "slippageKBps",
        "blockDelay",
        "exists",
        "paused"
      ],
      "properties": {
        "asset": { "$ref": "#/$defs/hex20" },
        "slot0": { "$ref": "#/$defs/u256" },
        "totalPrincipalAmount": { "$ref": "#/$defs/u128" },
        "slippageKBps": { "$ref": "#/$defs/u32" },
        "blockDelay": { "$ref": "#/$defs/u8" },
        "exists": { "type": "boolean" },
        "paused": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "partnerFee": {
      "type": "object",
      "required": ["asset", "feeBps"],
      "properties": {
        "asset": { "$ref": "#/$defs/hex20" },
        "feeBps": { "$ref": "#/$defs/u32" }
      },
      "additionalProperties": false
    },
    "feeProfile": {
      "type": "object",
      "required": ["whitelisted", "blacklistFeeMultiplier", "partnerFeeBps"],
      "properties": {
        "whitelisted": { "type": "boolean" },
        "blacklistFeeMultiplier": { "$ref": "#/$defs/u256" },
        "partnerFeeBps": {
          "type": "array",
          "items": { "$ref": "#/$defs/partnerFee" }
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["cash", "lanes", "feeProfile"],
      "properties": {
        "cash": { "$ref": "#/$defs/hex20" },
        "lanes": { "type": "array", "items": { "$ref": "#/$defs/lane" } },
        "feeProfile": { "$ref": "#/$defs/feeProfile" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
