{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunarbase.dev/schemas/quote-state/v2",
  "title": "LunarBase quote checkpoint v2",
  "type": "object",
  "required": ["magic", "schemaVersion", "mathCompatibilityVersion", "expectedRuntimeCodeHash", "cursor", "state"],
  "properties": {
    "magic": { "const": "LBQ1" },
    "schemaVersion": { "const": 2 },
    "mathCompatibilityVersion": { "type": "string", "minLength": 1 },
    "expectedRuntimeCodeHash": { "$ref": "#/$defs/hex32" },
    "cursor": { "$ref": "#/$defs/cursor" },
    "state": { "$ref": "#/$defs/state" }
  },
  "$defs": {
    "u256": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "hex20": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hex32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "commitment": { "enum": ["Realtime", "Canonical", "Finalized"] },
    "cursor": {
      "type": "object",
      "required": ["chainId", "blockNumber", "commitment"],
      "properties": {
        "chainId": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "blockNumber": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "blockHash": { "anyOf": [{ "$ref": "#/$defs/hex32" }, { "type": "null" }] },
        "transactionIndex": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)$" },
        "logIndex": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)$" },
        "sourceSequence": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)$" },
        "sourceSubIndex": { "type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)$" },
        "commitment": { "$ref": "#/$defs/commitment" }
      },
      "additionalProperties": false
    },
    "lane": {
      "type": "object",
      "required": ["asset", "slot0", "exists", "paused", "blockDelay", "slippageKBps"],
      "properties": {
        "asset": { "$ref": "#/$defs/hex20" },
        "slot0": { "$ref": "#/$defs/u256" },
        "exists": { "type": "boolean" },
        "paused": { "type": "boolean" },
        "blockDelay": { "$ref": "#/$defs/u256" },
        "slippageKBps": { "$ref": "#/$defs/u256" }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["cash", "stateVersion", "blacklistFeeMultiplier", "lanes", "principal", "whitelist", "partnerFeeBps"],
      "properties": {
        "cash": { "$ref": "#/$defs/hex20" },
        "stateVersion": { "$ref": "#/$defs/u256" },
        "blacklistFeeMultiplier": { "$ref": "#/$defs/u256" },
        "lanes": { "type": "array", "items": { "$ref": "#/$defs/lane" } },
        "principal": { "type": "array", "items": { "type": "object", "required": ["asset", "amount"], "properties": { "asset": { "$ref": "#/$defs/hex20" }, "amount": { "$ref": "#/$defs/u256" } }, "additionalProperties": false } },
        "whitelist": { "type": "array", "items": { "type": "object", "required": ["router", "value"], "properties": { "router": { "$ref": "#/$defs/hex20" }, "value": { "type": "boolean" } }, "additionalProperties": false } },
        "partnerFeeBps": { "type": "array", "items": { "type": "object", "required": ["router", "asset", "fee"], "properties": { "router": { "$ref": "#/$defs/hex20" }, "asset": { "$ref": "#/$defs/hex20" }, "fee": { "$ref": "#/$defs/u256" } }, "additionalProperties": false } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
