{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunarbase.dev/schemas/normalized-events/v1",
  "title": "LunarBase normalized chain update v1",
  "oneOf": [
    { "$ref": "#/$defs/head" },
    { "$ref": "#/$defs/log" },
    { "$ref": "#/$defs/reorg" },
    { "$ref": "#/$defs/gap" }
  ],
  "$defs": {
    "u64": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "hex20": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "hex32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "cursor": {
      "type": "object",
      "required": ["chainId", "blockNumber", "executionBlockNumber", "commitment"],
      "properties": {
        "chainId": { "$ref": "#/$defs/u64" },
        "blockNumber": { "$ref": "#/$defs/u64" },
        "executionBlockNumber": { "$ref": "#/$defs/u64" },
        "blockHash": { "anyOf": [{ "$ref": "#/$defs/hex32" }, { "type": "null" }] },
        "transactionIndex": { "anyOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "logIndex": { "anyOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "sourceSequence": { "anyOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "sourceSubIndex": { "anyOf": [{ "$ref": "#/$defs/u64" }, { "type": "null" }] },
        "commitment": { "enum": ["Realtime", "Canonical", "Finalized"] }
      },
      "additionalProperties": false
    },
    "head": { "type": "object", "required": ["kind", "cursor"], "properties": { "kind": { "const": "Head" }, "cursor": { "$ref": "#/$defs/cursor" } }, "additionalProperties": false },
    "log": {
      "type": "object",
      "required": ["kind", "address", "topics", "data", "removed", "cursor"],
      "properties": {
        "kind": { "const": "Log" },
        "address": { "$ref": "#/$defs/hex20" },
        "topics": { "type": "array", "items": { "$ref": "#/$defs/hex32" } },
        "data": { "type": "string", "pattern": "^0x(?:[0-9a-fA-F]{2})*$" },
        "removed": { "type": "boolean" },
        "cursor": { "$ref": "#/$defs/cursor" }
      },
      "additionalProperties": false
    },
    "reorg": {
      "type": "object",
      "required": ["kind", "oldHead", "newHead"],
      "properties": {
        "kind": { "const": "Reorg" },
        "oldHead": { "$ref": "#/$defs/cursor" },
        "newHead": { "$ref": "#/$defs/cursor" }
      },
      "additionalProperties": false
    },
    "gap": { "type": "object", "required": ["kind", "reason"], "properties": { "kind": { "const": "Gap" }, "cursor": { "anyOf": [{ "$ref": "#/$defs/cursor" }, { "type": "null" }] }, "reason": { "type": "string", "minLength": 1 } }, "additionalProperties": false }
  }
}
