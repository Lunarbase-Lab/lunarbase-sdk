{
  "name": "@lunarbase/math-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc -b packages/math/tsconfig.json packages/client/tsconfig.json",
    "test": "node --test packages/math/dist/*.test.js",
    "format": "prettier --write \"packages/**/*.ts\"",
    "format:check": "prettier --check \"packages/**/*.ts\"",
    "lint": "eslint packages --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "typescript-eslint": "8.64.0"
  }
}
